# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"
JWT_SECRET="researchpulse_enterprise_jwt_secret_key_production_grade"
MAX_FILE_SIZE_MB=25

# Optional PostgreSQL with pgvector connection.
# When provided, ResearchPulse uses PostgreSQL with pgvector.
# If not provided or unreachable, high-performance local vector storage is used.
DATABASE_URL="postgresql://user:password@localhost:5432/researchpulse_db"
